// Cloudflare Workers config.
// Static files are served from the repo root; /api/* runs src/worker.js.
// Secrets (set in the Cloudflare dashboard, never in this file):
//   ADMIN_CODE    - the code that unlocks the admin panel
//   GITHUB_TOKEN  - GitHub token with Contents: Read and write on this repo
{
  "name": "studysmartly",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/games/*", "/data/*"]
  },
  "vars": {
    "GITHUB_REPO": "Godo-Bear/StudySmartly",
    "GITHUB_BRANCH": "main"
  },
  // keep the secrets set in the dashboard when this file is deployed
  "keep_vars": true,
  // Private storage for player accounts, sessions, unlocks and paid-game links.
  // No id needed: Cloudflare creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "DB" }],
  // Counts plays for the "Most played" section (free plan, SQLite-backed).
  // ACCESS holds each account's TRUE/FALSE "allowed" setting.
  "durable_objects": { "bindings": [
    { "name": "PLAYS", "class_name": "PlayCounter" },
    { "name": "ACCESS", "class_name": "AccessList" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlayCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["AccessList"] }
  ]
}
